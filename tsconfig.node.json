{
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "ES2022",
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "noEmit": true
    },
    "include": [
        "eslint-plugins.d.ts",
        "eslint.config.ts",
        "vite.config.ts",
        "postcss.config.ts",
        "tailwind.config.ts",
        "bin/**/*.ts",
        "scripts/**/*.ts"
    ]
}
